# Bridge API (bridgeapi.io) credentials — get these from the Bridge dashboard
# (sandbox or production app). Never commit real values.
BRIDGE_CLIENT_ID=
BRIDGE_CLIENT_SECRET=
BRIDGE_ENV=sandbox

# Bridge API version header and base URL (sandbox/production share the same
# base URL for v3; only Client-Id/Secret differ).
BRIDGE_API_VERSION=2025-01-15
BRIDGE_API_BASE_URL=https://api.bridgeapi.io/v3

# Optional: where Bridge Connect redirects the user after linking a bank.
# BRIDGE_CONNECT_CALLBACK_URL=

# 32-byte hex key (generate with: openssl rand -hex 32) used to encrypt
# stored Bridge access tokens at rest. Recommended before deploying.
# BRIDGE_TOKEN_ENCRYPTION_KEY=

# Shared secret required to call the manual /syncBridgeTransactions HTTP
# endpoint (sent as header x-sync-secret). Generate with: openssl rand -hex 32
SYNC_TRIGGER_SECRET=

# Bridge sandbox test user used by scripts/test-sync-sandbox.ts
BRIDGE_SANDBOX_TEST_USER_ID=sandbox-test-user
BRIDGE_SANDBOX_TEST_EMAIL=sandbox-test-user@example.com

# Firestore emulator, for local testing without a real GCP project
FIRESTORE_EMULATOR_HOST=localhost:8080
GCLOUD_PROJECT=demo-bankingperso

# Bridge API (bridgeapi.io) credentials — get these from the Bridge dashboard
# (sandbox or production app). Never commit real values.
BRIDGE_CLIENT_ID=
BRIDGE_CLIENT_SECRET=
BRIDGE_ENV=sandbox

# Bridge API version header and base URL (sandbox/production share the same
# base URL for v3; only Client-Id/Secret differ).
BRIDGE_API_VERSION=2025-01-15
BRIDGE_API_BASE_URL=https://api.bridgeapi.io/v3

# Optional: where Bridge Connect redirects the user after linking a bank.
# BRIDGE_CONNECT_CALLBACK_URL=

# 32-byte hex key (generate with: openssl rand -hex 32) used to encrypt
# stored Bridge access tokens at rest. Recommended before deploying.
# BRIDGE_TOKEN_ENCRYPTION_KEY=

# Shared secret required to call the manual /syncBridgeTransactions HTTP
# endpoint (sent as header x-sync-secret). Generate with: openssl rand -hex 32
SYNC_TRIGGER_SECRET=

# Bridge sandbox test user used by scripts/test-sync-sandbox.ts
BRIDGE_SANDBOX_TEST_USER_ID=sandbox-test-user
BRIDGE_SANDBOX_TEST_EMAIL=sandbox-test-user@example.com

# Firestore emulator, for local testing without a real GCP project
FIRESTORE_EMULATOR_HOST=localhost:8080
GCLOUD_PROJECT=demo-bankingperso

# --- Enable Banking (enablebanking.com) — restricted production ---
ENABLE_BANKING_CLIENT_ID=
# Path to the RSA private key .pem downloaded when the application was
# created. Never commit the real file — *.pem is gitignored.
ENABLE_BANKING_PRIVATE_KEY_PATH=./keys/enablebanking-private-key.pem
ENABLE_BANKING_ENV=production
ENABLE_BANKING_API_BASE_URL=https://api.enablebanking.com

# JWT time-to-live in seconds (Enable Banking rejects exp beyond 86400s / 24h).
ENABLE_BANKING_JWT_TTL_SECONDS=3600

# Only needed for the one-time interactive scripts/bootstrap-enable-banking-session.ts
# ENABLE_BANKING_ASPSP_NAME=
# ENABLE_BANKING_ASPSP_COUNTRY=
# ENABLE_BANKING_REDIRECT_URL=

# Firestore user id under which the linked session/transactions are stored.
ENABLE_BANKING_TARGET_USER_ID=me

# Optional sanity check for scripts/test-sync-enablebanking.ts (masked in logs).
# ENABLE_BANKING_EXPECTED_IBAN=

# Required by scripts/test-sync-enablebanking.ts before it will make any real
# API call — there is no sandbox here, every call hits a real linked account.
# I_UNDERSTAND_THIS_CALLS_PRODUCTION=yes
